{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(just check)",
      "Bash(just fmt)",
      "Bash(just fmt-check)",
      "Bash(just lint)",
      "Bash(just typecheck)",
      "Bash(just test)",
      "Bash(just protocol)",
      "Bash(cargo fmt:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo test:*)",
      "Bash(cargo check:*)",
      "Bash(pnpm --dir web typecheck)",
      "Bash(pnpm --dir web lint)",
      "Bash(pnpm --dir web test:*)",
      "Bash(pnpm --dir web storybook:test)",
      "Bash(pnpm --dir web exec oxfmt:*)",
      "Bash(pnpm --dir web exec oxlint:*)",
      "Bash(pnpm --dir web exec vitest run:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(sed -n:*)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.*)", "Read(./**/*.tfstate)", "Read(./**/*.pem)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-lint.sh", "timeout": 30 }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify-stop.sh", "timeout": 300 }]
      }
    ]
  }
}
